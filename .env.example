GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional. Comma-separated model(s) to fall back through, in order, when
# the primary model (JARVIS_MODEL, or its default) hits a Gemini free-tier
# rate limit -- daily cap or per-minute burst. Each has its own separate
# quota, so a longer chain means Jarvis is far less likely to actually run
# out for the day -- each later model can be a bit weaker, but a dumber
# reply beats no reply. Defaults to a 3-model chain if unset.
# JARVIS_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# Laptop <-> cloud relay heartbeat (optional, only for the "Always-on cloud
# relay" setup in README.md). Same JARVIS_HEARTBEAT_TOKEN value on both
# machines; the URL/port only matter on whichever side runs which piece:
#
# On the CLOUD VM (runs heartbeat_server.py):
# JARVIS_HEARTBEAT_TOKEN=pick-a-random-shared-secret
# JARVIS_HEARTBEAT_PORT=8765
#
# On the LAPTOP (runs main.py, which sends the heartbeat):
# JARVIS_HEARTBEAT_URL=http://your-cloud-vm-ip:8765/heartbeat
# JARVIS_HEARTBEAT_TOKEN=pick-a-random-shared-secret
